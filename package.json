{
  "name": "@unconfirmed/effect-sdks",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "test": "bun test packages/",
    "test:live": "SUI_LIVE=1 bun test packages/",
    "codegen": "bun run --filter @unconfirmed/effect-sui codegen"
  },
  "devDependencies": {
    "@mysten/codegen": "0.12.26",
    "@mysten/enoki": "2.0.1",
    "@mysten/seal": "2.0.1",
    "@mysten/sui": "3.0.1",
    "@mysten/walrus": "2.0.1",
    "@mysten/walrus-wasm": "0.3.1",
    "@types/bun": "^1.4.0",
    "@unconfirmed/effect-bcs": "workspace:*",
    "@unconfirmed/effect-quorum": "workspace:*",
    "@unconfirmed/effect-seal": "workspace:*",
    "@unconfirmed/effect-sui": "workspace:*",
    "@unconfirmed/effect-sui-codegen": "workspace:*",
    "@unconfirmed/effect-walrus": "workspace:*",
    "@unconfirmed/test-support": "workspace:*",
    "binaryen": "132.0.0",
    "effect": "4.1.6",
    "esbuild": "0.28.2",
    "rolldown": "1.3.4",
    "typescript": "5.9.3"
  }
}
