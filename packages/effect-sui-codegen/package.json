{
  "name": "@unconfirmed/effect-sui-codegen",
  "version": "0.1.0",
  "description": "Move codegen for @unconfirmed/effect-sui: typed BCS schemas and call builders from `sui move summary` output or an on-chain package, with a config file and a CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unconfirmedlabs/effect-packages.git",
    "directory": "packages/effect-sui-codegen"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "sui-codegen": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "peerDependencies": {
    "@unconfirmed/effect-bcs": "workspace:^",
    "@unconfirmed/effect-sui": "workspace:^",
    "effect": "^4.1.6"
  },
  "devDependencies": {
    "@mysten/codegen": "0.12.26",
    "@mysten/sui": "3.0.1",
    "@unconfirmed/test-support": "workspace:*"
  }
}
