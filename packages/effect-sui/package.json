{
  "name": "@unconfirmed/sui",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./grpc": "./src/grpc/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "codegen": "protoc -I proto/src --include_imports -o proto/sui-rpc.binpb $(cd proto/src && find sui -name '*.proto') && bun scripts/codegen-grpc.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@scure/base": "^2.3.0"
  },
  "peerDependencies": {
    "@unconfirmed/bcs": "workspace:^",
    "effect": "^4.1.6"
  },
  "devDependencies": {
    "@mysten/sui": "3.0.1",
    "@unconfirmed/test-support": "workspace:*"
  }
}
