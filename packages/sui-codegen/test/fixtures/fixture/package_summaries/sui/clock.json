          },
          "timestamp_ms": {
            "index": 1,
            "doc": " The clock's timestamp, which is set automatically by a\n system transaction every time consensus commits a\n schedule, or by `sui::clock::increment_for_testing` during\n testing.",
            "type_": "u64"
          }
        }
      }
    }
  },
