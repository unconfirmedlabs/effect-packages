  "structs": {
    "Clock": {
      "index": 0,
      "doc": " Singleton shared object that exposes time to Move calls.  This\n object is found at address 0x6, and can only be read (accessed\n via an immutable reference) by entry functions.\n\n Entry Functions that attempt to accept `Clock` by mutable\n reference or value will fail to verify, and honest validators\n will not sign or execute transactions that use `Clock` as an\n input parameter, unless it is passed by immutable reference.",
      "attributes": [],
      "abilities": [
        "Key"
      ],
